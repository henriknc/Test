<Window x:Class="CyclingBleSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cycling BLE Simulator" Height="700" Width="1000"
        Background="#F5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Device Management Section -->
        <GroupBox Header="Device Management" Grid.Row="0" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Devices:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        <ComboBox x:Name="DeviceComboBox"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DeviceName"
                                  MinWidth="200"
                                  Margin="5"/>
                        <Button Content="Add Device" Click="AddDevice_Click" Margin="5"/>
                        <Button Content="Remove Device" Click="RemoveDevice_Click" Margin="5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Start All" Click="StartAll_Click" Background="#4CAF50" Foreground="White" Margin="5"/>
                        <Button Content="Stop All" Click="StopAll_Click" Background="#f44336" Foreground="White" Margin="5"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0" DataContext="{Binding SelectedDevice}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Configuration and Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,5,0">
                <StackPanel>
                    <!-- Device Configuration -->
                    <GroupBox Header="Device Configuration" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Device Name:" FontWeight="Bold"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Enabled Services:" FontWeight="Bold" Margin="0,10,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                <CheckBox Content="Cycling Speed and Cadence (CSC)" IsChecked="{Binding EnableCSC}" IsEnabled="{Binding CanStart}"/>
                                <CheckBox Content="Cycling Power" IsChecked="{Binding EnablePower}" IsEnabled="{Binding CanStart}"/>
                                <CheckBox Content="Heart Rate Monitor" IsChecked="{Binding EnableHeartRate}" IsEnabled="{Binding CanStart}"/>
                                <CheckBox Content="Fitness Machine (Indoor Trainer)" IsChecked="{Binding EnableFitnessMachine}" IsEnabled="{Binding CanStart}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Data Mode:" FontWeight="Bold" Margin="0,10,0,0"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Auto-generate realistic data (uncheck for manual control)"
                                      IsChecked="{Binding AutoGenerate}"
                                      Margin="0,5,0,0"/>

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Start" Click="Start_Click" Background="#4CAF50" Foreground="White" IsEnabled="{Binding CanStart}"/>
                                <Button Content="Stop" Click="Stop_Click" Background="#f44336" Foreground="White" IsEnabled="{Binding CanStop}"/>
                                <Button Content="Reset Metrics" Click="Reset_Click" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Manual Controls -->
                    <GroupBox Header="Manual Controls" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Note: In auto-generate mode, these values set the baseline around which realistic variations occur."
                                       TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10"/>

                            <!-- Speed -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Speed:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding ManualSpeed}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualSpeed, StringFormat={}{0:F1} km/h}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Cadence -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cadence:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding ManualCadence}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualCadence, StringFormat={}{0} RPM}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Power -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Power:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding ManualPower}"
                                        TickFrequency="10" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualPower, StringFormat={}{0} W}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Heart Rate -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Heart Rate:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="60" Maximum="200" Value="{Binding ManualHeartRate}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualHeartRate, StringFormat={}{0} BPM}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Incline -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Incline:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-10" Maximum="20" Value="{Binding ManualIncline}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualIncline, StringFormat={}{0:F1}%}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Resistance -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Resistance:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding ManualResistance}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualResistance, StringFormat={}{0:F1}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel - Current Metrics and Status -->
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <!-- Status -->
                <GroupBox Header="Status" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Current Metrics -->
                <GroupBox Header="Current Metrics" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentSpeed, StringFormat={}{0:F1} km/h}"
                                   FontSize="18" Foreground="#2196F3" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cadence:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCadence, StringFormat={}{0} RPM}"
                                   FontSize="18" Foreground="#FF9800" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Power:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPower, StringFormat={}{0} W}"
                                   FontSize="18" Foreground="#4CAF50" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Heart Rate:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentHeartRate, StringFormat={}{0} BPM}"
                                   FontSize="18" Foreground="#F44336" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Distance:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentDistance, StringFormat={}{0:F0} m}"
                                   FontSize="18" Foreground="#9C27B0" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Calories:" FontWeight="Bold" Margin="5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCalories, StringFormat={}{0} kcal}"
                                   FontSize="18" Foreground="#FF5722" HorizontalAlignment="Right" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- Information -->
                <GroupBox Header="Information" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,5">
                            <Run Text="Services Implemented:" FontWeight="Bold"/><LineBreak/>
                            <Run Text="• Cycling Speed and Cadence (CSC)"/><LineBreak/>
                            <Run Text="• Cycling Power (CP)"/><LineBreak/>
                            <Run Text="• Heart Rate Monitor (HRM)"/><LineBreak/>
                            <Run Text="• Fitness Machine Service (FTM)"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic" Foreground="Gray">
                            To connect: Enable Bluetooth on your device and search for the device name shown in the status.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
